@page "/commercial/properties/{id:guid}"
@model RealEstate.Web.Pages.CommercialPropertyModel
@using RealEstate.Domain
@{ViewData["Title"]="Consulta comercial do imóvel";}
<a href="/commercial/customers">← Clientes e Atendimentos</a><div class="page-heading"><div><p class="eyebrow">Comercial · Somente leitura</p><h1>Consulta comercial do imóvel</h1></div></div>
@if(Model.Error is not null){<p class="notice error" role="alert">@Model.Error</p>}
@if(Model.Property is {} property){
<section class="card form-card customer-panel"><h2>@(property.CommercialCode??property.Data.Code??"Código pendente") · @property.Data.Type</h2><p>@property.Data.Title</p><p>@property.Data.Category · @property.Data.Purpose</p><p>@property.Data.Address?.Municipality · @property.Data.Address?.Neighborhood</p><p>Dormitórios: @(property.Data.Capture?.Rooms.Bedrooms?.ToString()??"Não informado") · Vagas: @(property.Data.Capture?.Rooms.Parking?.ToString()??"Não informado")</p><p class="muted">O cadastro original não é editado nesta consulta. Finalidades e valores podem ser consultados na carteira do atendimento.</p></section>
<section id="owner-summary" class="card commercial-panel"><h2>Resumo para conversa com o proprietário</h2><p class="muted">Indicadores agregados, sem identificação de clientes ou observações livres.</p><form method="get" class="form-grid"><label class="form-field">De<input asp-for="From" type="date"/></label><label class="form-field">Até (inclusive)<input asp-for="Through" type="date"/></label><button class="button secondary">Atualizar período</button></form>
@if(Model.Summary is {} summary){<dl class="commercial-metrics"><div><dt>Clientes únicos apresentados no período</dt><dd>@summary.UniqueCustomers</dd></div><div><dt>Apresentações no período</dt><dd>@summary.Presentations</dd></div><div><dt>Registros de visita no período</dt><dd>@summary.VisitRecords</dd></div><div><dt>Clientes cujo último retorno no período indica interesse ou negociação</dt><dd>@summary.InterestedCustomers</dd></div></dl><h3>Motivos de desinteresse — registros por categoria</h3>@if(summary.NegativeCategories.Count==0){<p>Sem retornos negativos no período.</p>}@foreach(var reason in summary.NegativeCategories.OrderByDescending(r=>r.Value)){<p>@reason.Key: @reason.Value</p>}<details><summary>Evolução dos registros por dia (UTC)</summary>@foreach(var day in summary.InteractionsByDay.OrderBy(d=>d.Key)){<p>@day.Key: @day.Value interação(ões)</p>}</details><p class="muted">Fonte: apresentações e retornos comerciais deste imóvel, na filial ativa. Período @(Model.From?.ToString("dd/MM/yyyy")) a @(Model.Through?.ToString("dd/MM/yyyy")) (Brasília). Uma pessoa pode ter várias apresentações e interações; visita não representa interesse ou proposta.</p>}
else if(Model.SummaryError is not null){<p role="status">@Model.SummaryError</p>}
</section>
<section id="property-commercial-history" class="card commercial-panel"><h2>Histórico comercial do imóvel</h2><p class="muted">Detalhes internos disponíveis somente com permissão de histórico comercial. O resumo acima não contém estes dados pessoais.</p>
@if(Model.History is {} history){@if(history.Count==0){<p>Nenhuma apresentação registrada.</p>}@foreach(var item in history){<article class="commercial-offer" data-interaction="@item.Id"><h3>@item.Status</h3><p><a href="/commercial/customers/@item.CustomerId">@item.CustomerName</a> · @item.At.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM/yyyy HH:mm") (Brasília) · @item.Channel</p><p>@item.Category · @item.Reason</p><p class="customer-description">@item.Notes</p><p class="muted">Autor: @Model.PersonName(item.Actor) · Responsável na ocasião: @Model.PersonName(item.ResponsibleSubject)</p>@if(Model.EligibleCustomers.Contains(item.CustomerId)){foreach(var offer in Model.NegotiableOffers){<a class="button secondary" href="/commercial/negotiations?CustomerId=@item.CustomerId&amp;PropertyId=@Model.Id&amp;AnnouncementId=@offer.Id&amp;Origin=property">Iniciar negociação · @offer.Purpose</a>}}</article>}}
else if(Model.HistoryError is not null){<p role="status">@Model.HistoryError</p>}
</section>
}
