@page "/"
@model IndexModel
@{ViewData["Title"]="Imóveis";}
<div class="page-heading"><div><p class="eyebrow">Imob</p><h1>Imóveis</h1><p class="muted">Consulte e mantenha seus imóveis e anúncios.</p></div>@if(Model.CanCreate){<a class="button primary" href="/properties/new">Cadastrar imóvel</a>}</div>
@if(Model.Notice is not null){<div class="notice" role="status">@Model.Notice</div>}
@if(Model.Error is not null){<section class="card status-panel error" role="alert" tabindex="-1" data-error-focus><h2>Não foi possível concluir</h2><p>@Model.Error</p><a class="button secondary" href="/">Tentar novamente</a></section>}
@if(Model.Workspace is {} ws){
<section class="card table-panel listing" data-listing aria-labelledby="list-title"><div class="table-toolbar"><div><h2 id="list-title">Imóveis e acompanhamento</h2><p class="muted">@ws.Total imóveis encontrados · página @Model.Filter.Page</p></div></div>
<form method="get" class="listing-controls"><partial name="_ListingControls" for="Filter"/><div class="listing-unit"><label for="unit-filter">Estabelecimento</label><select id="unit-filter" name="Filter.EstablishmentId"><option value="">Todos os autorizados</option>@foreach(var unit in ws.Establishments){<option value="@unit.Id" selected="@(Model.Filter.EstablishmentId==unit.Id)">@unit.Name</option>}</select></div></form>
@if(ws.Properties.Count==0){<div class="empty-state"><h3>@(Model.Filter.HasFilters?"Nenhum imóvel corresponde aos filtros":"Nenhum imóvel nesta página")</h3><p>Limpe os filtros ou volte à primeira página. Novos cadastros dependem das suas permissões.</p><a class="button secondary" href="/">Voltar à carteira</a></div>}else{
<div class="listing-selection"><label><input type="checkbox" data-select-page aria-controls="property-rows"/> Selecionar página</label><span data-selection-status role="status" aria-live="polite"></span><button class="button secondary small" type="button" data-clear-selection>Limpar seleção</button></div>
<p class="listing-scroll-hint" id="wallet-scroll-hint">Em telas intermediárias, deslize a tabela para conferir as demais informações. As ações estão junto do imóvel.</p>
<div class="listing-table-scroll" role="region" aria-label="Imóveis encontrados" aria-describedby="wallet-scroll-hint" tabindex="0"><table class="property-table wallet-table" aria-labelledby="list-title"><colgroup><col/><col/><col/><col/><col/><col/><col/></colgroup><thead><tr><th scope="col">Seleção</th><th scope="col">Foto</th>
<th scope="col" aria-sort="@Model.SortState("code")"><a href="@Model.SortHref("code")">Imóvel / código original ↕</a><br/><a href="@Model.SortHref("title")">Título ↕</a></th>
<th scope="col" aria-sort="@Model.SortState("municipality")"><a href="@Model.SortHref("municipality")">Cidade / UF ↕</a><br/><a href="@Model.SortHref("neighborhood")">Bairro ↕</a></th>
<th scope="col" aria-sort="@Model.SortState("type")"><a href="@Model.SortHref("type")">Tipo ↕</a><br/><a href="@Model.SortHref("purpose")">Finalidade original ↕</a></th>
<th scope="col">Valor (venda / locação)</th>
<th scope="col"><span>Valores e detalhes</span><br/><a href="@Model.SortHref("category")">Categoria ↕</a> · <a href="@Model.SortHref("price")">Preço histórico ↕</a> · <a href="@Model.SortHref("status")">Estado físico ↕</a></th></tr></thead><tbody id="property-rows">
@foreach(var p in ws.Properties){var address=p.Data.Address;var location=string.Join(" / ",new[]{address?.Municipality,address?.State}.Where(x=>!string.IsNullOrWhiteSpace(x)));<tr data-property data-search="@p.Data.Code @p.Data.Title">
<td data-label="Seleção"><input type="checkbox" data-select-row value="@p.Id" aria-label="Selecionar @p.Data.Code"/></td><td data-label="Foto">@if(Model.Covers.TryGetValue(p.Id,out var cover)){<img class="property-cover" src="/properties/@p.Id?handler=Content&amp;mediaId=@cover" alt="Foto principal de @p.Data.Code" loading="lazy"/>}else{<span class="property-photo-placeholder" role="img" aria-label="Sem foto principal">Sem foto</span>}</td>
<td data-label="Imóvel e ações"><a class="property-title" href="/portfolio/@p.Id"><strong>@(p.CommercialCode??"Código comercial pendente")</strong><br/>@(p.Data.Title??"Rascunho sem título")</a><small>@RealEstate.Domain.PropertyLifecycle.Label(p.Status)</small>@if(Model.CanEdit&&p.Status==RealEstate.Domain.PropertyLifecycle.Draft){<a class="button secondary small" href="/properties/@p.Id">Continuar captação</a>}</td>
<td data-label="Localização"><span>@(location.Length==0?"Não informada":location)</span><small>@(address?.Neighborhood??"Bairro não informado")</small></td>
<td data-label="Tipo e finalidade original"><span class="wallet-type">@p.Data.Type</span><small>@p.Data.Purpose</small></td>
<td data-label="Valor (venda / locação)">@{var prices=Model.WalletValues(p).ToArray();}@foreach(var price in prices){<a class="wallet-announcement wallet-value" href="/properties/@p.Id@(price.AnnouncementId is {} announcementId?"?announcementId="+announcementId:"")"><span>@price.Purpose</span><strong>@(price.Value.Authorized is null?"Não informado":RealEstate.Web.Brl.Currency(price.Value.Authorized))</strong>@if(price.Value.DifferentAdvertised){<small>Anunciado: @(price.Value.Advertised is null?"Não informado":RealEstate.Web.Brl.Currency(price.Value.Advertised))</small>}</a>}@if(prices.Length==0){<span>Não informado</span>}</td>
<td data-label="Valores e detalhes"><details class="wallet-secondary"><summary>Ver valores e detalhes</summary><div><strong>Valores do anúncio original / legado</strong><partial name="_CommercialValues" model="p.Data"/><p>Valor histórico não classificado: @RealEstate.Web.Brl.Currency(p.Data.Price)</p><p>Categoria: @(p.Data.Category??"Não informada")</p><p>Estado físico: @(RealEstate.Domain.PropertyLifecycle.Label(p.Status))</p></div></details></td></tr>}
</tbody></table></div>}
<nav class="listing-pagination" aria-label="Páginas da carteira">@if(Model.Filter.Page>1){<a class="button secondary" href="@Model.PageHref(Model.Filter.Page-1)">Anterior</a>}<span>Página @Model.Filter.Page · @ws.Total resultados · até @RealEstate.Domain.PropertyListQuery.PageSize por página</span>@if((long)Model.Filter.Page*RealEstate.Domain.PropertyListQuery.PageSize<ws.Total){<a class="button secondary" href="@Model.PageHref(Model.Filter.Page+1)">Próxima</a>}</nav>
</section>
@if(Model.CanCreateOwner){<details class="card owner-panel"><summary>Cadastrar proprietário</summary><p class="muted" id="owner-hint">O proprietário pode ser informado ao completar o rascunho.</p><form method="post" asp-page-handler="Owner" data-submit-feedback><label for="OwnerName">Nome do proprietário</label><input asp-for="OwnerName" required maxlength="200" aria-describedby="owner-hint"/><button type="submit" class="button secondary" data-pending-label="Salvando proprietário…">Salvar proprietário</button><span class="submit-status sr-only" role="status"></span></form></details>}
}
<link rel="stylesheet" href="/listing.css"/>
<link rel="stylesheet" href="/media.css"/>
<script src="/listing.js" defer></script>
