@page "/commercial/negotiations/{key?}"
@model RealEstate.Web.Pages.NegotiationsModel
@{var individual=Model.Opening||Model.Key is not null;ViewData["Title"]=individual?"Jornada de Negociação":"Negociações";}
<div class="page-heading"><div><p class="eyebrow">Comercial</p><h1>@(individual?"Jornada de Negociação":"Negociações")</h1></div></div>
@if(Model.Error is not null){<p class="notice error" role="alert">@Model.Error</p>}
@if(Model.Detail is {} item){

 <a href="/commercial/negotiations">← Negociações</a>
 <section class="card form-card customer-panel"><h2>Resumo comercial</h2><dl><div><dt>Situação</dt><dd>Em preparação</dd></div><div><dt>Cliente</dt><dd>@Model.DetailLabel?.Customer <a href="/commercial/customers/@item.CustomerId">Abrir ficha</a></dd></div><div><dt>Imóvel</dt><dd>@Model.DetailLabel?.Property <a href="/commercial/properties/@item.PropertyId">Abrir imóvel</a></dd></div><div><dt>Oferta e modalidade</dt><dd>@Model.DetailLabel?.Offer · @Model.DetailLabel?.Purpose</dd></div><div><dt>Responsável</dt><dd>@Model.ResponsibleName(item.ResponsibleSubject)</dd></div><div><dt>Versão</dt><dd>@item.Version</dd></div></dl><p class="muted">A abertura registrada não reserva o imóvel nem altera sua disponibilidade.</p></section>
 <section id="negotiation-actions" class="card form-card customer-panel" aria-labelledby="negotiation-actions-title">
 <h2 id="negotiation-actions-title">Ações</h2>
 @if(Model.ActionAccessDenied){<p class="notice" role="status">As ações não estão disponíveis para este acesso. A consulta respeita os direitos atuais.</p>}
 @if(Model.ActionLoadError is not null){<p class="notice error" role="alert">As ações não puderam ser carregadas agora. @Model.ActionLoadError</p>}
 else if(!Model.ActionAccessDenied&&Model.Actions.Count==0&&Model.ActionLoadError is null){<p>Nenhuma ação registrada nesta negociação.</p>}
 @if(Model.CanCreateActions){
 <details class="appointment-create"><summary>Adicionar ação</summary><form method="post" asp-page-handler="CreateAction" data-negotiation-action-form>@Html.AntiForgeryToken()<input type="hidden" asp-for="Key"/><input type="hidden" asp-for="ActionRequestId"/>
 <div class="form-grid">
 <label class="form-field">Tipo<select asp-for="ActionKind" id="negotiation-action-kind" required><option value="Contato">Contato</option><option value="Compromisso">Compromisso</option><option value="Pendência">Pendência</option><option value="Outros">Outros</option></select></label>
 @if(Model.ActionResponsibleOptions.Count>1){<label class="form-field">Responsável<select asp-for="ActionResponsibleSubject">@foreach(var option in Model.ActionResponsibleOptions){<option value="@option.Subject">@option.DisplayName@(option.Subject==item.ResponsibleSubject?" (responsável atual)":"")</option>}</select></label>}else{<input type="hidden" asp-for="ActionResponsibleSubject"/>}
 <label class="form-field full">Descrição<textarea asp-for="ActionDescription" maxlength="4000" required></textarea></label>
 <div class="form-field" data-action-due><label for="ActionDueLocal">Prazo</label><input asp-for="ActionDueLocal" type="datetime-local"/></div>
 <fieldset class="form-field full" data-action-appointment hidden><legend>Compromisso na Agenda</legend><div class="form-grid"><label class="form-field">Tipo de compromisso<select asp-for="ActionAppointmentKind"><option value="@AppointmentRules.PropertyVisit">@AppointmentRules.PropertyVisit</option><option value="@AppointmentRules.Office">@AppointmentRules.Office</option></select></label><label class="form-field">Início (horário de Brasília)<input asp-for="ActionAppointmentStart" type="datetime-local"/></label><label class="form-field">Término (horário de Brasília)<input asp-for="ActionAppointmentEnd" type="datetime-local"/></label><label class="form-field">Local da visita ou unidade<input asp-for="ActionAppointmentLocation" maxlength="300"/></label><label class="form-field full">Observações<textarea asp-for="ActionAppointmentNotes" maxlength="4000"></textarea></label></div><p class="muted">O horário é definido no compromisso da Agenda; não há prazo genérico para este tipo de ação. Um compromisso novo será criado junto com o vínculo desta negociação. Para atendimento na imobiliária, informe a unidade @Model.AppointmentUnitName.</p><a href="/commercial/agenda">Consultar Agenda Comercial</a></fieldset>
 </div><button class="button primary" type="submit">Registrar ação</button></form></details>
 }else if(!Model.ActionAccessDenied){<p class="muted">Você pode consultar as ações; o direito atual não permite registrar ou concluir.</p>}
 @if(Model.Actions.Count>0){var next=Model.Actions.Where(a=>a.Status=="Aberta").OrderBy(a=>Model.ActionAppointments.TryGetValue(a.Id,out var linked)?linked.StartsAt:a.DueAt??DateTimeOffset.MaxValue).FirstOrDefault();if(next is not null){<article class="appointment-card"><h3>Próxima ação</h3><p><strong>@next.Kind:</strong> @next.Description</p><p>Responsável: @next.ResponsibleName@if(next.DueAt is {} nextDue){<span> · Prazo: @AgendaModel.Local(nextDue).ToString("dd/MM/yyyy HH:mm")</span>}else if(Model.ActionAppointments.TryGetValue(next.Id,out var nextAppointment)){<span> · @AgendaModel.Local(nextAppointment.StartsAt).ToString("dd/MM/yyyy HH:mm")–@AgendaModel.Local(nextAppointment.EndsAt).ToString("HH:mm")</span>}</p></article>}
 <div class="appointment-list">@foreach(var action in Model.Actions){var linked=Model.ActionAppointments.TryGetValue(action.Id,out var appt)?appt:null;<article class="appointment-card"><span class="agenda-type">@action.Kind</span> <span class="badge @(action.Status=="Concluída"?"active":"admin")">@action.Status</span><h3>@action.Description</h3><p>Responsável: @action.ResponsibleName@if(action.DueAt is {} due){<span> · Prazo: @AgendaModel.Local(due).ToString("dd/MM/yyyy HH:mm")</span>}</p>@if(linked is not null){<p>Agenda: @AgendaModel.Local(linked.StartsAt).ToString("dd/MM/yyyy HH:mm")–@AgendaModel.Local(linked.EndsAt).ToString("HH:mm") · @linked.Location</p><a href="@Model.AgendaHref(action)">Abrir compromisso na Agenda</a>}@if(action.Result is not null){<p><strong>Resultado:</strong> @action.Result</p>}
 @if(action.Status=="Aberta"&&Model.CanCreateActions){<details><summary>Concluir</summary><form method="post" asp-page-handler="CompleteAction">@Html.AntiForgeryToken()<input type="hidden" name="Key" value="@Model.Key"/><input type="hidden" name="actionId" value="@action.Id"/><input type="hidden" name="version" value="@action.Version"/><input type="hidden" name="requestId" value="@Guid.NewGuid()"/><label class="form-field" for="CompletionResult-@action.Id">Resultado</label><textarea id="CompletionResult-@action.Id" name="CompletionResult" maxlength="1000" required>@Model.CompletionResult</textarea><button class="button primary" type="submit">Confirmar conclusão</button></form></details>}
 <details><summary>Histórico</summary>@foreach(var entry in Model.ActionEvents.Where(e=>e.ActionId==action.Id)){<p><time datetime="@entry.At.ToString("O")">@AgendaModel.Local(entry.At).ToString("dd/MM/yyyy HH:mm")</time> · @entry.Event · @Model.ResponsibleName(entry.Actor) · Responsável: @Model.ResponsibleName(entry.ResponsibleSubject) @if(entry.Result is not null){<span> · @entry.Result</span>}</p>}</details></article>}</div>}
 </section>
 <script src="/negotiation-actions.js" defer></script>
 <section class="card form-card customer-panel"><h2>Histórico</h2>@foreach(var ev in Model.Events){<p><time datetime="@ev.At.ToString("O")">@ev.At.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM/yyyy HH:mm")</time> · @if(ev.Action=="Opened"){<span>Negociação iniciada</span>}else{<span>Responsável alterado: @Model.ResponsibleName(ev.PreviousResponsibleSubject) → @Model.ResponsibleName(ev.ResponsibleSubject)</span> @if(!string.IsNullOrWhiteSpace(ev.Reason)){<span> · @ev.Reason</span>}}</p>}</section>
 @if(Model.TransferAccessDenied){<p class="notice access-denied" role="status">A transferência assistida não está disponível para este acesso hierárquico.</p>}
 @if(Model.TransferDependencyMessage is not null){<p class="notice error" role="alert">@Model.TransferDependencyMessage</p>}
 @if(Model.CanTransfer&&Model.TransferOptions.Count>0){<section id="negotiation-transfer" class="card form-card customer-panel"><h2>Transferir responsabilidade</h2><p class="eyebrow">Transferência assistida</p><p>Escolha atividades abertas. Itens não selecionados permanecem com o responsável atual. A transferência da negociação não altera horários na Agenda.</p><form method="post" asp-page-handler="PreviewActivityTransfer">@Html.AntiForgeryToken()<input type="hidden" asp-for="Key"/><input type="hidden" asp-for="TransferRequestId"/><input type="hidden" asp-for="TransferVersion"/><label class="form-field">Novo responsável<select asp-for="TransferResponsibleSubject" required><option value="">Selecione</option>@foreach(var responsible in Model.TransferOptions){<option value="@responsible.Subject">@responsible.DisplayName</option>}</select></label><label class="form-field">Responsável pelos follow-ups<select asp-for="FollowupResponsibleSubject"><option value="">Responsável pela confirmação</option>@foreach(var responsible in Model.TransferOptions){<option value="@responsible.Subject">@responsible.DisplayName</option>}</select></label><label class="form-field">Motivo (opcional)<input asp-for="TransferReason" maxlength="500"/></label><fieldset class="transfer-activity-options"><legend>Atividades abertas</legend>@if(Model.TransferActivities.Count>0){foreach(var candidate in Model.TransferActivities){var action=candidate.Action;<label class="transfer-activity-option"><input type="checkbox" name="SelectedActivityIds" value="@action.Id" checked="@(Model.SelectedActivityIds.Contains(action.Id))"/> <span>@action.Kind — @action.Description</span></label>}}else{<p>Nenhuma atividade aberta elegível. A negociação ainda pode mudar de responsável.</p>}</fieldset><button class="button primary" type="submit">Gerar prévia</button></form>
 @if(Model.ActivityTransferPreview is {} preview){var followupCount=preview.Decisions.Count(x=>!x.WillTransfer);<h3>Prévia da transferência</h3><ul>@foreach(var decision in preview.Decisions){var candidate=preview.EligibleActivities.Single(x=>x.Action.Id==decision.ActionId);var action=candidate.Action;<li>@action.Kind — @action.Description: @(decision.WillTransfer?"será transferida":"permanecerá com "+Model.ResponsibleName(action.ResponsibleSubject)+(decision.ConflictReason is null?"":"; follow-up por conflito")) @if(!decision.WillTransfer&&candidate.Appointment is {} blocked){<span>· @AgendaModel.Local(blocked.StartsAt).ToString("dd/MM/yyyy HH:mm")–@AgendaModel.Local(blocked.EndsAt).ToString("HH:mm")</span>}</li>}</ul><p>Novo responsável: @Model.TransferOptions.SingleOrDefault(x=>x.Subject==Model.TransferResponsibleSubject)?.DisplayName</p><p>Follow-ups encaminhados a: @Model.ResponsibleName(Model.FollowupResponsibleSubject)</p><p>Conflitos ficam com o responsável original; não há reagendamento ou cancelamento automático.</p>@if(followupCount>0){<p>Após a confirmação, serão criados @followupCount @(followupCount==1?"follow-up":"follow-ups") para tratamento por @Model.ResponsibleName(Model.FollowupResponsibleSubject).</p>}<form method="post" asp-page-handler="ConfirmActivityTransfer">@Html.AntiForgeryToken()<input type="hidden" asp-for="Key"/><input type="hidden" name="TransferPreviewToken" value="@preview.Token"/><button class="button primary" type="submit">Confirmar transferência (@preview.Decisions.Count(x=>x.WillTransfer) ações; @followupCount follow-ups)</button></form>}</section>}
 @if(Model.CanTransfer){<section id="negotiation-transfer-followups" class="card form-card customer-panel"><h2>Acompanhamento da transferência</h2>@if(Model.ActivityFollowups.Count==0){<p>Nenhum follow-up pendente ou resolvido nesta negociação.</p>}@foreach(var followup in Model.ActivityFollowups){<article class="appointment-card"><span class="badge">@followup.Status</span><p>@NegotiationActivityTransferRules.ConflictReasonLabel(followup.Reason) · Responsável pelo encaminhamento: @followup.ResponsibleName</p>@if(followup.Result is not null){<p>Resultado: @followup.Result</p>}<details><summary>Histórico</summary>@foreach(var ev in Model.ActivityFollowupEvents.Where(e=>e.FollowupId==followup.Id)){<p><time datetime="@ev.At.ToString("O")">@AgendaModel.Local(ev.At).ToString("dd/MM/yyyy HH:mm")</time> · @ev.Event · @Model.ResponsibleName(ev.Actor)@if(ev.Result is not null){<span> · @ev.Result</span>}</p>}</details>@if(followup.Status=="Pendente de tratamento"&&Model.CanTransfer){<details><summary>Resolver follow-up</summary><form method="post" asp-page-handler="ResolveTransferFollowup">@Html.AntiForgeryToken()<input type="hidden" asp-for="Key"/><input type="hidden" name="followupId" value="@followup.Id"/><input type="hidden" name="version" value="@followup.Version"/><input type="hidden" name="requestId" value="@Guid.NewGuid()"/><label class="form-field">Resultado<textarea name="FollowupResult" maxlength="1000" required></textarea></label><button class="button primary" type="submit">Registrar resolução</button></form></details>}</article>}</section>}
}else if(Model.Opening&&Model.Customer is not null&&Model.Offer is not null){
 <a href="@Model.ReturnUrl">← Voltar à consulta comercial</a>
 <section class="card form-card customer-panel"><h2>Iniciar negociação</h2><p><strong>Cliente:</strong> @Model.OpeningLabel?.Customer</p><p><strong>Imóvel:</strong> @Model.OpeningLabel?.Property</p><p><strong>Oferta e modalidade:</strong> @Model.OpeningLabel?.Offer · @Model.OpeningLabel?.Purpose</p><p><strong>Responsável:</strong> @Model.ResponsibleName(Model.ResponsibleSubject)</p><p class="muted">A abertura cria uma jornada em preparação. Ela não reserva nem bloqueia o imóvel.</p><form method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="CustomerId"/><input type="hidden" asp-for="PropertyId"/><input type="hidden" asp-for="AnnouncementId"/><input type="hidden" asp-for="Origin"/><input type="hidden" asp-for="RequestId"/>
 @if(Model.ManagerialOpening){<label class="form-field" asp-for="ResponsibleSubject">Responsável pela negociação<select asp-for="ResponsibleSubject" required><option value="">Selecione</option>@foreach(var responsible in Model.ResponsibleOptions){<option value="@responsible.Subject">@responsible.DisplayName</option>}</select></label>}else{<input type="hidden" asp-for="ResponsibleSubject"/>}
 <button class="button primary" type="submit">Iniciar negociação</button></form></section>
}else if(Model.Result is {} result){
 <form method="get" class="card form-card customer-panel"><label class="form-field">Cliente (identificador)<input name="CustomerId" value="@Model.CustomerId"/></label><button class="button secondary">Filtrar</button> <a href="/commercial/negotiations">Limpar</a></form>
 <section class="card form-card customer-panel"><h2>Negociações (@result.Total)</h2>@if(result.Items.Count==0){<p>Nenhuma negociação encontrada nesta filial. <a href="/commercial/customers">Consultar clientes e atendimentos</a></p>}else{<div class="listing-table-scroll" role="region" aria-label="Negociações encontradas" tabindex="0"><table class="property-table"><thead><tr><th>Cliente</th><th>Imóvel e oferta</th><th>Modalidade</th><th>Situação</th><th>Responsável</th><th>Ação</th></tr></thead><tbody>@foreach(var n in result.Items){Model.Labels.TryGetValue(n.Id,out var label);<tr><td data-label="Cliente">@(label?.Customer??"Indisponível")</td><td data-label="Imóvel e oferta">@(label is null?"Indisponível":label.Property+" · "+label.Offer)</td><td data-label="Modalidade">@(label?.Purpose??"Indisponível")</td><td data-label="Situação">Em preparação</td><td data-label="Responsável">@Model.ResponsibleName(n.ResponsibleSubject)</td><td data-label="Ação"><a href="/commercial/negotiations/@n.Id">Abrir jornada</a></td></tr>}</tbody></table></div>}</section>
}
