@page "/commercial/agenda"
@model RealEstate.Web.Pages.AgendaModel
@using RealEstate.Domain
@{
    ViewData["Title"] = "Agenda comercial";
    var today = DateOnly.FromDateTime(AgendaModel.Local(DateTimeOffset.UtcNow).DateTime);
    var previous = Model.View == "month" ? Model.Selected.AddMonths(-1) : Model.Selected.AddDays(Model.View == "week" ? -7 : -1);
    var next = Model.View == "month" ? Model.Selected.AddMonths(1) : Model.Selected.AddDays(Model.View == "week" ? 7 : 1);
    var culture = new System.Globalization.CultureInfo("pt-BR");
    var period = Model.View == "day" ? Model.First.ToString("dddd, dd 'de' MMMM 'de' yyyy", culture) : Model.View == "month" ? Model.First.ToString("MMMM 'de' yyyy", culture) : Model.First.ToString("dd/MM") + " a " + Model.Last.AddDays(-1).ToString("dd/MM/yyyy");
}
<div class="agenda-page">
<a class="agenda-back" href="/commercial/customers"><svg class="icon small-icon" aria-hidden="true"><use href="/araia/icons.svg#i-back"/></svg>Clientes e Atendimentos</a>
<header class="agenda-header"><div><p class="eyebrow">Comercial</p><h1>Agenda comercial</h1><p class="muted">Compromissos da filial ativa</p></div>@if(Model.CanManage){<button class="button primary" type="button" data-agenda-new><svg class="icon small-icon" aria-hidden="true"><use href="/araia/icons.svg#i-plus"/></svg>Novo compromisso</button>}</header>
@if (TempData["AgendaNotice"] is string notice) { <p class="notice" role="status">@notice</p> }
@if (TempData["AgendaError"] is string agendaError) { <p class="notice error" role="alert">@agendaError</p> }
@if (Model.Error is not null) { <p class="notice error" role="alert">@Model.Error</p> }
else {
@if(Model.CanManage){<details id="agenda-new" class="card agenda-new"><summary>Escolha como iniciar</summary><div class="agenda-new-options"><a href="/commercial/customers"><svg class="icon" aria-hidden="true"><use href="/araia/icons.svg#i-users"/></svg><span><strong>Visita ou atendimento com cliente</strong><small>Encontre o cliente e agende pela ficha.</small></span></a>@if(Model.CanCreateCapture){<a href="#capture-owner"><svg class="icon" aria-hidden="true"><use href="/araia/icons.svg#i-home"/></svg><span><strong>Visita de captação</strong><small>Selecione um proprietário existente.</small></span></a>}</div></details>}
<div class="agenda-toolbar card"><div class="agenda-period"><a class="button secondary small" href="@Model.Href(Model.View,today)">Hoje</a><a class="icon-button" href="@Model.Href(Model.View,previous)" aria-label="Período anterior"><svg class="icon small-icon agenda-flip" aria-hidden="true"><use href="/araia/icons.svg#i-chevron"/></svg></a><strong>@period</strong><a class="icon-button" href="@Model.Href(Model.View,next)" aria-label="Próximo período"><svg class="icon small-icon" aria-hidden="true"><use href="/araia/icons.svg#i-chevron"/></svg></a></div><nav class="agenda-view-switch" aria-label="Visualização da agenda"><a href="@Model.Href("day",Model.Selected)" aria-current="@(Model.View=="day"?"page":null)" class="@(Model.View=="day"?"active":null)">Dia</a><a href="@Model.Href("week",Model.Selected)" aria-current="@(Model.View=="week"?"page":null)" class="@(Model.View=="week"?"active":null)">Semana</a><a href="@Model.Href("month",Model.Selected)" aria-current="@(Model.View=="month"?"page":null)" class="@(Model.View=="month"?"active":null)">Mês</a></nav></div>
<div class="agenda-workspace"><aside class="agenda-sidebar">
<form class="card agenda-filters" method="get" action="/commercial/agenda"><h2><svg class="icon small-icon" aria-hidden="true"><use href="/araia/icons.svg#i-filter"/></svg>Filtros</h2><input type="hidden" name="View" value="@Model.View"/><label>Ir para a data<input type="date" name="Date" value="@Model.Selected.ToString("yyyy-MM-dd")"/></label><label>Responsável<select name="Responsible"><option value="">Todos</option>@foreach(var person in Model.Responsibles){<option value="@person.Subject" selected="@(Model.Responsible==person.Subject)">@person.Name</option>}</select></label><label>Tipo<select name="Kind"><option value="">Todos</option>@foreach(var kind in AppointmentRules.Kinds){<option value="@kind" selected="@(Model.Kind==kind)">@kind</option>}</select></label><label>Situação<select name="Status"><option value="">Todas</option>@foreach(var status in new[]{"Agendado","Realizado","Cancelado"}){<option value="@status" selected="@(Model.Status==status)">@AgendaModel.StatusLabel(status)</option>}</select></label><button class="button secondary" type="submit">Aplicar filtros</button>@if(Model.Responsible is not null||Model.Kind is not null||Model.Status is not null){<a href="/commercial/agenda?View=@Model.View&Date=@Model.Selected.ToString("yyyy-MM-dd")">Limpar filtros</a>}</form>
<section class="card agenda-summary" aria-label="Resumo do período"><h2>Este período</h2><div><span>Confirmados</span><strong>@Model.ScheduledCount</strong></div><div><span>Realizados</span><strong>@Model.CompletedCount</strong></div><div><span>Cancelados</span><strong>@Model.CanceledCount</strong></div></section>
<section class="card agenda-upcoming"><h2>Próximos compromissos</h2>@if(Model.Upcoming.Count==0){<p class="muted">Nenhum compromisso futuro encontrado.</p>}@foreach(var item in Model.Upcoming){var display=Model.Display[item.Id];<a href="#appointment-@item.Id"><time>@AgendaModel.Local(item.StartsAt).ToString("dd/MM HH:mm")</time><strong>@display.Person</strong><small>@item.Kind</small></a>}</section>
</aside><div class="agenda-main">
<section id="agenda-calendar-top" class="card agenda-calendar" aria-label="Calendário"><div class="agenda-calendar-heading"><h2>@(Model.View=="day"?"Dia":Model.View=="week"?"Semana":"Mês")</h2><span>@Model.Items.Count compromisso(s) após filtros</span></div>
<div class="agenda-days agenda-@Model.View">@for(var date=Model.First;date<Model.Last;date=date.AddDays(1)){var day=date;var dayItems=Model.Items.Where(x=>DateOnly.FromDateTime(AgendaModel.Local(x.StartsAt).DateTime)==day).OrderBy(x=>x.StartsAt).ToArray();<section class="agenda-day @(day==today?"today":null)"><h3><a href="@Model.Href("day",day)"><span>@day.ToString("ddd",culture)</span><strong>@day.Day</strong></a></h3>@foreach(var item in dayItems){var display=Model.Display[item.Id];<a class="agenda-entry agenda-kind-@AgendaModel.KindClass(item.Kind) agenda-status-@item.Status.ToLowerInvariant()" href="#appointment-@item.Id" aria-label="@item.Kind, @AgendaModel.Local(item.StartsAt).ToString("HH:mm"), @display.Person, @item.Status"><time>@AgendaModel.Local(item.StartsAt).ToString("HH:mm")</time><strong>@display.Person</strong><small>@item.Kind</small><span class="agenda-entry-status">@AgendaModel.StatusLabel(item.Status)</span></a>}@if(dayItems.Length==0&&Model.View=="day"){<p class="muted">Sem compromissos neste dia.</p>}</section>}</div>
<div class="agenda-mobile-list">@if(Model.Items.Count==0){<p class="muted">Nenhum compromisso neste período. Escolha outra data ou ajuste os filtros.</p>}@foreach(var group in Model.Items.OrderBy(x=>x.StartsAt).GroupBy(x=>DateOnly.FromDateTime(AgendaModel.Local(x.StartsAt).DateTime))){<section><h3>@group.Key.ToString("dddd, dd/MM",culture)</h3>@foreach(var item in group){var display=Model.Display[item.Id];<a class="agenda-entry agenda-kind-@AgendaModel.KindClass(item.Kind) agenda-status-@item.Status.ToLowerInvariant()" href="#appointment-@item.Id"><time>@AgendaModel.Local(item.StartsAt).ToString("HH:mm")</time><strong>@display.Person</strong><small>@item.Kind</small><span class="agenda-entry-status">@AgendaModel.StatusLabel(item.Status)</span></a>}</section>}</div></section>
@if(Model.CanCreateCapture){<details id="capture-owner" class="card agenda-capture" open="@(Model.OwnerSearch is not null)"><summary>Agendar visita de captação com proprietário</summary><p class="muted">O imóvel pode ser cadastrado após a visita.</p><form method="get" action="/commercial/agenda#capture-owner" class="appointment-property-search"><input type="hidden" name="View" value="@Model.View"/><input type="hidden" name="Date" value="@Model.Selected.ToString("yyyy-MM-dd")"/><label>Buscar proprietário<input asp-for="OwnerSearch" maxlength="200" placeholder="Nome do proprietário"/></label><button class="button secondary" type="submit">Buscar</button></form>@if(Model.OwnerSearch is not null&&Model.OwnerMatches.Count==0){<p class="muted">Nenhum proprietário encontrado. Confira o nome pesquisado.</p>}@if(Model.OwnerMatches.Count>0){<form method="post" asp-page-handler="Capture"><input type="hidden" asp-for="RequestId"/><div class="form-grid"><label class="form-field">Proprietário<select asp-for="OwnerId" required><option value="">Selecione</option>@foreach(var owner in Model.OwnerMatches){<option value="@owner.Id">@owner.Name</option>}</select></label><label class="form-field">Responsável comercial<select asp-for="ResponsibleSubject" required><option value="">Selecione</option>@foreach(var candidate in Model.Candidates){<option value="@candidate.Subject">@candidate.DisplayName</option>}</select></label><label class="form-field">Início (Brasília)<input asp-for="StartLocal" type="datetime-local" required/></label><label class="form-field">Término (Brasília)<input asp-for="EndLocal" type="datetime-local" required/></label><label class="form-field full">Endereço do imóvel a captar<input asp-for="Location" maxlength="300" required/></label><label class="form-field full">Observações<textarea asp-for="Notes" maxlength="4000"></textarea></label></div><button class="button primary" type="submit">Agendar visita de captação</button></form>}</details>}
</div></div>
@foreach(var item in Model.Items.Concat(Model.Upcoming).DistinctBy(x=>x.Id)){var display=Model.Display[item.Id];<section id="appointment-@item.Id" class="agenda-detail" aria-label="Detalhes do compromisso"><a class="agenda-detail-close" href="#agenda-calendar-top" aria-label="Fechar detalhes"><svg class="icon" aria-hidden="true"><use href="/araia/icons.svg#i-close"/></svg></a><div class="agenda-detail-head"><span class="agenda-type agenda-kind-@AgendaModel.KindClass(item.Kind)">@item.Kind</span><h2>@display.Person</h2><span class="badge @(item.Status=="Realizado"?"active":item.Status=="Cancelado"?"revoked":"admin")">@AgendaModel.StatusLabel(item.Status)</span></div><dl><dt>Quando</dt><dd>@AgendaModel.Local(item.StartsAt).ToString("dd/MM/yyyy HH:mm") a @AgendaModel.Local(item.EndsAt).ToString("HH:mm")</dd><dt>Responsável</dt><dd>@item.ResponsibleName</dd><dt>Local</dt><dd>@item.Location</dd>@if(display.Property is not null){<dt>Imóvel</dt><dd>@display.Property</dd>}@if(item.Notes is not null){<dt>Observações</dt><dd class="agenda-prewrap">@item.Notes</dd>}@if(item.Result is not null){<dt>Resultado</dt><dd class="agenda-prewrap">@item.Result</dd>}</dl>@if(item.CustomerId is {} customer){<a class="button secondary" href="/commercial/customers/@customer#customer-agenda">Abrir ficha do cliente</a>}
@if(Model.CanManage&&(item.OwnerId is null&&item.PropertyId is null||Model.CanReadProperty)&&item.Status=="Agendado"){<div class="agenda-detail-actions"><details><summary>Reagendar</summary><form method="post" asp-page-handler="Appointment" asp-route-action="Reagendar"><input type="hidden" name="AppointmentId" value="@item.Id"/><input type="hidden" name="AppointmentVersion" value="@item.Version"/><input type="hidden" name="CustomerId" value="@item.CustomerId"/><input type="hidden" name="OwnerId" value="@item.OwnerId"/><input type="hidden" name="PropertyId" value="@item.PropertyId"/><input type="hidden" name="AppointmentKind" value="@item.Kind"/><input type="hidden" name="RequestId" value="@Guid.NewGuid()"/><input type="hidden" name="View" value="@Model.View"/><input type="hidden" name="Date" value="@Model.Selected.ToString("yyyy-MM-dd")"/><label>Novo início<input name="StartLocal" type="datetime-local" required/></label><label>Novo término<input name="EndLocal" type="datetime-local" required/></label><label>Local<input name="Location" value="@item.Location" required/></label><button class="button secondary" type="submit">Salvar reagendamento</button></form></details><form method="post" asp-page-handler="Appointment" asp-route-action="Cancelar"><input type="hidden" name="AppointmentId" value="@item.Id"/><input type="hidden" name="AppointmentVersion" value="@item.Version"/><input type="hidden" name="CustomerId" value="@item.CustomerId"/><input type="hidden" name="OwnerId" value="@item.OwnerId"/><input type="hidden" name="View" value="@Model.View"/><input type="hidden" name="Date" value="@Model.Selected.ToString("yyyy-MM-dd")"/><button class="button secondary" type="submit">Cancelar compromisso</button></form><form method="post" asp-page-handler="Appointment" asp-route-action="Realizar"><input type="hidden" name="AppointmentId" value="@item.Id"/><input type="hidden" name="AppointmentVersion" value="@item.Version"/><input type="hidden" name="CustomerId" value="@item.CustomerId"/><input type="hidden" name="OwnerId" value="@item.OwnerId"/><input type="hidden" name="View" value="@Model.View"/><input type="hidden" name="Date" value="@Model.Selected.ToString("yyyy-MM-dd")"/><label>Resultado do compromisso<textarea name="Result" maxlength="4000" required></textarea></label><button class="button primary" type="submit">Marcar como realizado</button></form></div>}
<details class="agenda-detail-history"><summary>Histórico de alterações</summary>@if(Model.History.TryGetValue(item.Id,out var history)){@foreach(var entry in history){<p><strong>@entry.Action</strong> · @AgendaModel.Local(entry.At).ToString("dd/MM/yyyy HH:mm")<br/><small>Responsável: @item.ResponsibleName</small></p>}}</details></section>}
}
</div>
