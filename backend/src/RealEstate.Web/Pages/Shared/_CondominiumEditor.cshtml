@model RealEstate.Web.Pages.PropertyModel
<div class="form-field full capture-group" data-condominium-editor data-shared-name="@Model.CondominiumName" data-shared="@System.Text.Json.JsonSerializer.Serialize(Model.LinkedCondominium?.Data.Characteristics??[],new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web))">
<input type="hidden" name="Input.Capture.Condominium.Id" value="@Model.Input.Capture?.Condominium.Id"/>
<input type="hidden" name="Input.Capture.Condominium.ObservedVersion" value="@(Model.LinkedCondominium?.Version??Model.Input.Capture?.Condominium.ObservedVersion)"/>
<label>Herdar características coletivas<select name="Input.Capture.Condominium.Inherit"><option value="">Manter seleções locais</option><option value="true" selected="@(Model.Input.Capture?.Condominium.Inherit==true)">Herdar do condomínio</option><option value="false" selected="@(Model.Input.Capture?.Condominium.Inherit==false)">Não herdar</option></select></label>
@if(Model.LinkedCondominium is {} linked&&Model.Input.Capture?.Condominium.Inherit==true&&Model.Input.Capture.Condominium.ObservedVersion!=linked.Version){<p role="note">As características compartilhadas foram atualizadas. Confira as informações herdadas e suas exceções antes de salvar.</p>}
@if(Model.CanEditCondominium){<button type="button" class="button secondary" data-edit-shared="Condominium">Editar condomínio vinculado</button>}
<p>Condomínio vinculado: <strong data-condominium-current>@(Model.CondominiumName??"Não informado")</strong></p>
<small data-condominium-provenance hidden="@(Model.LinkedCondominium is null)">Origem compartilhada: @Model.LinkedCondominium?.Id · versão @Model.LinkedCondominium?.Version</small>
<button class="button secondary" type="button" data-condominium-clear>Desvincular condomínio</button>
<label>Buscar condomínio nesta empresa<input maxlength="200" data-condominium-query/></label><button type="button" class="button secondary" data-condominium-search>Buscar</button><div data-condominium-results class="form-actions"></div>
@if(Model.CanCreate){<details><summary>Cadastrar condomínio</summary><p class="muted">Busque primeiro para reutilizar um cadastro existente. Torre, bloco e unidade pertencem ao imóvel.</p><div class="form-grid">
<label>Nome<input data-condominium-name maxlength="200"/></label><label>Tipo<select data-condominium-kind><option value="">Selecione</option><option value="residential">Residencial</option><option value="commercial">Comercial</option><option value="mixed">Misto</option><option value="other">Outro</option></select></label>
<label>Número de torres<input data-condominium-towers type="number" min="0" step="1"/></label><label>Número de pavimentos<input data-condominium-floors type="number" min="0" step="1"/></label><label>Observações do condomínio<textarea data-condominium-notes maxlength="2000"></textarea></label></div><button type="button" class="button secondary" data-condominium-create>Cadastrar condomínio</button></details>}
<p role="status" aria-live="polite"></p><p class="muted">A herança é opcional. Incluir ou excluir um item herdado cria uma exceção apenas para este imóvel, sem alterar o condomínio.</p></div>
