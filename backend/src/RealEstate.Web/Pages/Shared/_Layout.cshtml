@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject RealEstate.Domain.ICoreAccess Access
@{
    var canReadProperties=(await Access.RequireAsync("properties","PROPERTY_READ",Context.RequestAborted)).IsSuccess;
    var canReadCustomers=(await RealEstate.Web.CustomerOperationalRights.ReadScopeAsync(Access,Context.RequestAborted)).IsSuccess;
    var canViewNegotiations=canReadCustomers&&canReadProperties&&(await Access.RequireAsync("negotiations","NEGOTIATION_VIEW",Context.RequestAborted)).IsSuccess;
    var fixture = Configuration["EvidenceFixture"] == "true";
    var scope = Context.Items[typeof(RealEstate.Domain.AccessScope)] as RealEstate.Domain.AccessScope;
    var company = scope?.OrganizationName ?? "Contexto indisponível";
    var identity = User.FindFirst("name")?.Value ?? User.FindFirst("preferred_username")?.Value ?? "Usuário autenticado";
    var properties = Context.Request.Path == "/" || Context.Request.Path.StartsWithSegments("/properties");
}
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="color-scheme" content="light"/><title>@ViewData["Title"] · AraIa</title><link rel="stylesheet" href="/erp.css"/></head><body><div class="application">
<a class="skip-link" href="#main">Ir para o conteúdo</a><button id="menu-backdrop" class="menu-backdrop" aria-label="Fechar navegação" hidden></button>
<aside id="sidebar" class="sidebar" aria-label="Navegação principal"><div class="sidebar-brand"><a class="wordmark" href="/" aria-label="AraIa — imóveis"><span class="institutional-logo"><img src="/araia/hero-araia.webp" alt="AraIa"/></span></a><button id="close-menu" class="icon-button mobile-only" aria-label="Fechar menu">✕</button></div>
<div class="workspace-label"><span class="workspace-mark" aria-hidden="true">IM</span><div><strong id="sidebar-company">@company</strong><span>Imob</span></div></div><p class="nav-label">ÁREA DE TRABALHO</p>
<nav id="main-navigation">@if(canReadProperties){<details class="nav-group" open><summary>Imóveis</summary><a href="/" class="nav-item @(properties && !Context.Request.Path.StartsWithSegments("/showcase") ? "active" : null)" aria-current="@(properties && !Context.Request.Path.StartsWithSegments("/showcase") ? "page" : null)"><svg class="icon" aria-hidden="true"><use href="/araia/icons.svg#i-building"/></svg>Imóveis</a><a href="/showcase" class="nav-item @(Context.Request.Path.StartsWithSegments("/showcase") ? "active" : null)" aria-current="@(Context.Request.Path.StartsWithSegments("/showcase") ? "page" : null)">Vitrine Digital</a></details>}@if(canReadCustomers){var agendaActive=Context.Request.Path.StartsWithSegments("/commercial/agenda");var negotiationsActive=Context.Request.Path.StartsWithSegments("/commercial/negotiations");<details class="nav-group" open><summary>Comercial</summary><a href="/commercial/customers" class="nav-item @(Context.Request.Path.StartsWithSegments("/commercial/customers") ? "active" : null)" aria-current="@(Context.Request.Path.StartsWithSegments("/commercial/customers") ? "page" : null)">Clientes e Atendimentos</a>@if(canViewNegotiations){<a href="/commercial/negotiations" class="nav-item @(negotiationsActive ? "active" : null)" aria-current="@(negotiationsActive ? "page" : null)">Negociações</a>}@if(Configuration.GetValue<bool>("Agenda:Enabled")){<a href="/commercial/agenda" class="nav-item @(agendaActive ? "active" : null)" aria-current="@(agendaActive ? "page" : null)"><svg class="icon" aria-hidden="true"><use href="/araia/icons.svg#i-layout"/></svg>Agenda comercial</a>}</details>}</nav>
<div class="sidebar-bottom"><p class="sidebar-note">Inteligências conectadas.<br/>Possibilidades infinitas.</p></div></aside>
<div class="work-area"><header id="app-header" class="app-header"><div class="header-location"><button id="open-menu" class="icon-button mobile-only" aria-label="Abrir menu" aria-controls="sidebar" aria-expanded="false">☰</button><span class="header-wordmark">AraIa</span><span class="header-divider"></span><span id="header-company">@company</span></div><div class="header-actions"><a class="button secondary small portal-link" href="@(new Uri(new Uri(Configuration["Core:BaseUrl"] ?? "https://localhost:1/"),"app"))">Portal AraIa</a>@if(User.Identity?.IsAuthenticated==true){<span class="erp-identity">@identity</span><form method="post" action="/account/logout" class="logout-form">@Html.AntiForgeryToken()<button class="button secondary small" type="submit">Sair</button></form>}else{<a class="button secondary small" href="/account/login">Entrar com AraIa</a>}</div></header>
<main id="main" class="main-content" tabindex="-1">@if(fixture){<div class="evidence-banner" role="note">AMBIENTE DE PROVA DO MÓDULO · Identidade e direitos de teste · @(Configuration["UiOnlyFixture"]=="true"?"Dados sintéticos em memória":"PostgreSQL real") · Não comprova licença ou integração AraIa</div>}<div id="workspace-content">@RenderBody()</div><footer class="content-footer"><span>AraIa · Imob</span><span>Cadastro em rascunho</span></footer></main></div></div><script src="/araia-shell.js" defer></script><script src="/erp.js" defer></script><script type="module" src="/brl.js"></script></body></html>
