@model RealEstate.Web.Pages.CustomerModel
@using RealEstate.Domain
@using RealEstate.Web
<section id="presented-properties" class="card commercial-panel">
<div class="commercial-heading"><div><h2>Imóveis oferecidos ao cliente</h2><p class="muted">Registro dos imóveis apresentados, retorno individual do cliente e justificativas.</p></div>@if(Model.CanReadCommercial&&Model.CanReadProperty){<a class="button primary" href="/commercial/customers/@Model.Key?Panel=properties&amp;Search=true#property-search">Buscar imóveis na carteira</a>}</div>
@if(Model.CommercialError is not null){<p class="notice" role="status">@Model.CommercialError</p>}
@if(Model.CanReadCommercial){
var groups=Model.Interactions.GroupBy(i=>i.PresentationId).ToArray();
<p class="muted">@groups.Length apresentações · @Model.Interactions.Count(i=>i.Id!=i.PresentationId) retornos registrados</p>
@if(groups.Length==0){<p>Nenhum imóvel apresentado neste atendimento.</p>}
@if(groups.Length>0){<div class="commercial-offer-head" aria-hidden="true"><span>Imóvel</span><span>Apresentação</span><span>Retorno do cliente</span><span>Justificativa / observação</span></div>}
@foreach(var group in groups){var latest=group.First();var initial=group.Last();
<article class="commercial-offer" data-presentation="@group.Key" data-property="@latest.PropertyId"><div class="commercial-offer-main"><div><span class="commercial-cell-label">Imóvel</span><h3>@if(Model.CanReadProperty){<a href="/commercial/properties/@latest.PropertyId">@latest.PropertyCode</a>}else{@latest.PropertyCode} · @latest.PropertyTitle</h3></div><div><span class="commercial-cell-label">Apresentação</span><p><time datetime="@initial.At.ToString("O")">@initial.At.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM/yyyy HH:mm")</time></p><p>@initial.Channel</p></div><div><span class="commercial-cell-label">Retorno do cliente</span><strong class="commercial-status">@latest.Status</strong></div><div><span class="commercial-cell-label">Justificativa / observação</span>@if(latest.Category is not null||latest.Reason is not null){<p>@latest.Category · @latest.Reason</p>}<p class="customer-description">@latest.Notes</p></div></div>
@if(Model.CanSchedule&&Model.CanVisitProperty){<a class="button secondary" href="/commercial/customers/@Model.Key?VisitPresentation=@group.Key&amp;Panel=agenda#customer-agenda">Agendar visita</a>}
@if(Model.CanPresent){<details open="@(Model.PresentationId==group.Key)"><summary>Registrar novo retorno</summary><form method="post" asp-page-handler="Feedback" data-feedback-for="@group.Key"><input type="hidden" name="Panel" value="properties"/><input type="hidden" name="PresentationId" value="@group.Key"/><div class="form-grid"><label class="form-field">Situação<select name="ReturnStatus">@foreach(var status in CommercialInteractionRules.Statuses){<option selected="@(status==(Model.PresentationId==group.Key?Model.ReturnStatus??latest.Status:latest.Status))">@status</option>}</select></label><label class="form-field">Canal<select name="ReturnChannel">@foreach(var channel in CommercialInteractionRules.Channels){<option selected="@(channel==(Model.PresentationId==group.Key?Model.ReturnChannel:"Outro"))">@channel</option>}</select></label><label class="form-field">Categoria do motivo<select name="ReturnCategory"><option value="">Selecione se aplicável</option>@foreach(var category in CommercialInteractionRules.Categories){<option selected="@(Model.PresentationId==group.Key&&category==Model.ReturnCategory)">@category</option>}</select></label><label class="form-field">Motivo individual<input name="ReturnReason" maxlength="1000" value="@(Model.PresentationId==group.Key?Model.ReturnReason:null)"/></label><label class="form-field full">Observações<textarea name="ReturnNotes" maxlength="4000">@(Model.PresentationId==group.Key?Model.ReturnNotes:null)</textarea></label></div><p class="muted">Em “Sem interesse”, informe categoria e motivo. Apresentação, visita e proposta são registros distintos.</p><button class="button primary">Registrar retorno</button></form></details>}
<details><summary>Histórico deste imóvel no atendimento (@group.Count())</summary>@foreach(var item in group){<p>@item.At.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM/yyyy HH:mm") (Brasília) · @item.Channel · @item.Status · @item.Category · @item.Reason</p><p class="customer-description">@item.Notes</p><p class="muted">Autor: @item.Actor · Responsável na ocasião: @item.ResponsibleSubject</p>}</details>
</article>}
}
</section>
@if(Model.CanReadCommercial&&Model.CanReadProperty&&Model.Search){
@if(Model.CanStartNegotiation&&Model.Properties?.Announcements is {} eligibleOffers){foreach(var property in Model.Properties.Properties.Where(p=>p.Status==PropertyLifecycle.Available)){foreach(var offer in eligibleOffers.GetValueOrDefault(property.Id)??[]){<p><a class="button secondary" href="/commercial/negotiations?CustomerId=@Model.Key&amp;PropertyId=@property.Id&amp;AnnouncementId=@offer.Id">Iniciar negociação · @(property.CommercialCode??property.Data.Title) · @offer.Purpose</a></p>}}}
<section id="property-search" class="card commercial-panel"><h2>Buscar imóveis para apresentar</h2>
@{var listingControlsViewData=new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData){["ListingClearUrl"]=Model.PanelHref("properties")+"&Search=true#property-search"};}
<form method="get" class="listing-controls commercial-search listing"><input type="hidden" name="Panel" value="properties"/><input type="hidden" name="Search" value="true"/><partial name="_ListingControls" for="Filter" view-data="listingControlsViewData"/>
<details class="listing-filters commercial-advanced-filters"><summary>Características, vagas e medidas</summary><div class="listing-grid">
<div><label for="Filter_MinBedrooms">Dormitórios mínimos</label><input id="Filter_MinBedrooms" name="Filter.MinBedrooms" type="number" min="0" step="1" value="@Model.Filter.MinBedrooms"/></div>
<div><label for="Filter_MinParking">Vagas mínimas</label><input id="Filter_MinParking" name="Filter.MinParking" type="number" min="0" step="1" value="@Model.Filter.MinParking"/></div>
<div><label for="Filter_AreaKind">Medida da área</label><select id="Filter_AreaKind" name="Filter.AreaKind"><option value="total" selected="@(Model.Filter.AreaKind=="total")">Total</option><option value="built" selected="@(Model.Filter.AreaKind=="built")">Construída</option><option value="private" selected="@(Model.Filter.AreaKind=="private")">Privativa</option><option value="usable" selected="@(Model.Filter.AreaKind=="usable")">Útil</option><option value="land" selected="@(Model.Filter.AreaKind=="land")">Terreno</option></select></div>
<div><label for="Filter_AreaUnit">Unidade da área</label><select id="Filter_AreaUnit" name="Filter.AreaUnit"><option value="m2" selected="@(Model.Filter.AreaUnit=="m2")">m²</option><option value="ha" selected="@(Model.Filter.AreaUnit=="ha")">Hectares</option><option value="alqueire" selected="@(Model.Filter.AreaUnit=="alqueire")">Alqueires</option></select></div>
<div><label for="Filter_RegionalVariant">Variante regional do alqueire</label><input id="Filter_RegionalVariant" name="Filter.RegionalVariant" maxlength="200" value="@Model.Filter.RegionalVariant"/></div>
<div><label for="Filter_MinArea">Área mínima</label><input id="Filter_MinArea" name="Filter.MinArea" type="number" min="0" step="any" value="@Model.Filter.MinArea"/></div>
<div><label for="Filter_MaxArea">Área máxima</label><input id="Filter_MaxArea" name="Filter.MaxArea" type="number" min="0" step="any" value="@Model.Filter.MaxArea"/></div>
<div class="full"><label for="Feature">Característica</label><select id="Feature" name="Feature"><option value="">Todas</option>@foreach(var group in CaptureCatalog.Groups){<optgroup label="@group.Label">@foreach(var option in group.Options){var value=group.Id+":"+option.Id;<option value="@value" selected="@(Model.Feature==value)">@option.Label</option>}</optgroup>}</select></div>
</div><p class="muted">Medidas só são comparadas na mesma unidade. A faixa de valor usa anúncios ativos e valores autorizados.</p></details>
</form>
@if(Model.Properties is {} wallet){<h3>@wallet.Total imóvel(is) encontrado(s)</h3>
@if(wallet.Properties.Count==0){<p>Nenhum imóvel corresponde aos filtros.</p>}
else{<div class="commercial-listing-results listing" data-listing>
@if(Model.CanPresent){<div class="listing-selection"><label><input type="checkbox" data-select-page aria-controls="commercial-property-cards"/> Selecionar imóveis desta página</label><span data-selection-status role="status" aria-live="polite"></span><button class="button secondary small" type="button" data-clear-selection>Limpar seleção</button></div><form method="post" asp-page-handler="Present" id="presentation-form"><input type="hidden" name="Panel" value="properties"/></form>}
<div class="commercial-property-grid" id="commercial-property-cards">
@foreach(var property in wallet.Properties){var cardViewData=new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData){["CustomerModel"]=Model};
@if(Model.CanPresent){<label class="commercial-property-card"><input form="presentation-form" type="checkbox" name="SelectedProperties" value="@property.Id" checked="@(Model.SelectedProperties?.Contains(property.Id)==true)" data-select-row aria-label="Selecionar o imóvel @(property.CommercialCode??"sem código comercial") para apresentação"/><partial name="_CommercialPropertyCardContent" model="property" view-data="cardViewData"/></label>}
else{<article class="commercial-property-card is-readonly"><partial name="_CommercialPropertyCardContent" model="property" view-data="cardViewData"/></article>}}
</div>@if(Model.CanPresent){<fieldset class="commercial-presentation-options"><legend>Canal da apresentação</legend><div class="commercial-channel-options">@foreach(var channel in CommercialInteractionRules.Channels){var icon=channel switch{"Presencial"=>"i-building","Telefone"=>"i-users","WhatsApp"=>"i-users","E-mail"=>"i-mail","Visita"=>"i-home",_=>"i-info"};<label class="commercial-channel-option"><input form="presentation-form" type="radio" asp-for="PresentationChannel" value="@channel" required/><span class="commercial-channel-card"><svg class="icon" aria-hidden="true"><use href="/araia/icons.svg#@icon"/></svg><span>@channel</span></span></label>}</div></fieldset><label class="form-field commercial-notes">Observações<textarea asp-for="PresentationNotes" form="presentation-form" maxlength="4000"></textarea></label><p class="muted">Selecione até 25 imóveis desta página. O vínculo registra a apresentação e preserva o histórico comercial.</p><button form="presentation-form" class="button primary" type="submit">Registrar apresentação dos selecionados</button>}</div>}
<nav class="listing-pagination" aria-label="Páginas da carteira">@if(Model.Filter.Page>1){<a class="button secondary" href="@Model.PageHref(Model.Filter.Page-1)">Anterior</a>}<span>Página @Model.Filter.Page · @wallet.Total resultados · até @PropertyListQuery.PageSize por página</span>@if((long)Model.Filter.Page*PropertyListQuery.PageSize<wallet.Total){<a class="button secondary" href="@Model.PageHref(Model.Filter.Page+1)">Próxima</a>}</nav>}
</section>
}
<link rel="stylesheet" href="/listing.css"/><link rel="stylesheet" href="/media.css"/><script src="/listing.js" defer></script>
