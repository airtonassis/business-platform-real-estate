@model RealEstate.Web.Pages.PropertyModel
@if(Model.Allowed&&(Model.IsNew||Model.Gallery is not null)){var gallery=Model.Gallery??new MediaCollection([],"");
<section id="gallery" class="card media-gallery" data-media-gallery data-property-copy="@(Model.IsPropertyCopy?"true":"false")" data-new-property="@(Model.IsNew?"true":"false")" data-revision="@gallery.Revision" aria-labelledby="gallery-title"><h2 id="gallery-title">Fotos e vídeos</h2><p class="muted">Escolha fotos do computador ou use a câmera, quando disponível. Envie os arquivos e escreva uma mensagem curta junto de cada foto. Clique na foto para ampliar.</p>
@if(Model.IsPropertyCopy){<p class="muted">Revise as fotos e descrições. As alterações e os arquivos selecionados serão gravados somente ao salvar o novo imóvel.</p>}else if(Model.IsNew&&(Model.CanWrite&&!Model.SharedReadOnly)){<p class="muted">No primeiro envio, o rascunho será salvo com os dados preenchidos para vincular as fotos ao imóvel.</p>}
<p id="media-status" role="status" aria-live="polite">@Model.MediaNotice</p>
@if((Model.CanWrite&&!Model.SharedReadOnly)){<form method="post" asp-page-handler="Upload" enctype="multipart/form-data" data-media-upload><label for="media-files">Adicionar fotos e vídeos</label><input id="media-files" name="files" type="file" multiple accept="image/jpeg,image/png,video/mp4" required aria-describedby="media-limits"/><p id="media-limits" class="muted">Até 20 arquivos por envio: JPEG/PNG até 10 MiB; MP4 até 50 MiB; lote até 100 MiB; cota de 250 MiB por imóvel.</p><label for="media-camera" class="button secondary">Usar câmera, se disponível</label><input id="media-camera" type="file" accept="image/jpeg,image/png" capture="environment" class="sr-only"/><button class="button primary" type="submit">Enviar mídias</button><noscript><p>O upload e os comandos da galeria precisam de JavaScript para envio seguro.</p></noscript></form>}
@if(gallery.Items.Count==0){<p class="empty-state">Nenhuma mídia cadastrada. A carteira continuará com o placeholder neutro.</p>}else{<div class="media-grid">
@foreach(var item in gallery.Items){var content=$"/properties/{(Model.IsPropertyCopy?Model.CopyFrom:Model.IsDuplicate?Model.SourcePropertyId:Guid.Parse(Model.Key!))}?handler=Content&mediaId={item.Id}";var description=Model.Input.Capture?.Media.FirstOrDefault(m=>m.MediaId==item.Id)?.Caption;<article class="media-card" data-media-id="@item.Id" data-kind="@item.Kind"><div class="media-preview">@if(item.Kind=="image"){<button type="button" class="media-enlarge" data-media-enlarge data-description="@description" aria-label="Ampliar foto: @item.Name"><img src="@content" alt="@(string.IsNullOrWhiteSpace(description)?"Foto do imóvel: "+item.Name:description)" loading="lazy"/></button>}else{<video src="@content" controls preload="metadata" aria-label="Vídeo do imóvel: @item.Name"></video>}</div><p><strong>@(item.Kind=="video"?"Vídeo":"Foto")</strong> · @(item.Position+1) @if(item.IsCover){<span class="badge" data-cover>Capa</span>}</p><p class="media-name">@item.Name</p>@if(!string.IsNullOrWhiteSpace(description)){<p class="media-description">@description</p>}<small class="muted">@((item.Size/(1024m*1024)).ToString("0.00")) MiB</small>
@if((Model.CanWrite&&!Model.SharedReadOnly)){var index=Model.Input.Capture!.Media.FindIndex(m=>m.MediaId==item.Id);var captionId="media-caption-"+item.Id;<label for="@captionId">Mensagem curta (opcional)</label><textarea id="@captionId" form="property-form" name="Input.Capture.Media[@index].Caption" maxlength="@(description?.Length>200?2000:200)" data-image-description data-original-description="@description" rows="2" aria-describedby="@(captionId+"-help")">@description</textarea><small id="@(captionId+"-help")">Até 200 caracteres. Edite sem reenviar o arquivo.</small>@if(description?.Length>200){<small>Legenda anterior preservada; ao editar, use até 200 caracteres.</small>}<button type="submit" form="property-form" class="button secondary" data-save-description>Salvar descrição</button><div class="media-actions">@if(item.Kind=="image"&&!item.IsCover){<form method="post" asp-page-handler="Cover" data-media-action><input type="hidden" name="mediaId" value="@item.Id"/><input type="hidden" name="mediaRevision" value="@gallery.Revision"/><button class="button secondary" type="submit">Definir capa</button></form>}
<button class="button secondary" type="button" data-media-move="-1" disabled="@(item==gallery.Items.First())" aria-label="Mover @item.Name para cima">↑</button><button class="button secondary" type="button" data-media-move="1" disabled="@(item==gallery.Items.Last())" aria-label="Mover @item.Name para baixo">↓</button>
<form method="post" asp-page-handler="Remove" data-media-action data-media-remove><input type="hidden" name="mediaId" value="@item.Id"/><input type="hidden" name="mediaRevision" value="@gallery.Revision"/><button class="button secondary" type="submit">Remover</button></form></div>}
</article>}
</div>}
<dialog class="media-lightbox" data-media-lightbox aria-labelledby="media-lightbox-description"><form method="dialog"><button class="button secondary" autofocus>Fechar foto</button></form><img alt=""/><p id="media-lightbox-description"></p></dialog>
</section>}
